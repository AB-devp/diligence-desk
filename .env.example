# Create a key at https://aistudio.google.com/apikey
# New keys start with "AQ." (authorization keys). Older keys start with "AIza". Both work here.
GEMINI_API_KEY=

# Model used for analysis, memo and questions. Set this to one that check_gemini.py reports as working.
GEMINI_MODEL=gemini-3.5-flash

# "gemini" (default) for keys from Google AI Studio.
# Use "vertex" only for keys created in Google Cloud for Vertex AI.
GEMINI_BACKEND=gemini
